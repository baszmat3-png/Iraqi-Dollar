# Required
DATABASE_URL=postgres://user:password@localhost:5432/iraqi_dollar
JWT_SECRET=change-me-to-a-long-random-string
WA_API_KEY=your-wpsender-key

# Optional
WA_API_URL=https://backendapi.wpsenderx.com/api/messages/send
DATABASE_SSL=false            # use false for local Postgres
CORS_ORIGIN=                  # comma-separated origins, only if frontend is hosted elsewhere
OTP_DEBUG=false               # true = print OTP in server log when WA_API_KEY is empty (never in production)
PORT=3000
NODE_ENV=development
