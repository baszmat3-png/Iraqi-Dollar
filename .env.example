# Database & Security
DATABASE_URL=postgres://user:password@localhost:5432/iraqi_dollar
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_SSL=false            # use false for local Postgres, true for Render

# Email OTP Service (Nodemailer - Gmail SMTP)
GMAIL=your-email@gmail.com
APP_PASS=your-gmail-16-char-app-password

# WhatsApp Service (WP Sender API)
WPSENDER_API_KEY=your-wpsender-key
WPSENDER_API_URL=https://backendapi.wpsenderx.com/api/messages/send
# Backward compatibility aliases:
# WA_API_KEY=your-wpsender-key
# WA_API_URL=https://backendapi.wpsenderx.com/api/messages/send

# Store Admin Panel
ADMIN_PASSWORD=change-admin-password-for-production

# App Settings
PORT=3000
NODE_ENV=development
OTP_DEBUG=false               # true = log OTP to console in development when credentials are empty
CORS_ORIGIN=                  # comma-separated origins, only if frontend is hosted elsewhere

# تخزين بصمة كلمة المرور كـHMAC (اختياري؛ انظر أعلى pass-pepper.js قبل التفعيل). نص عشوائي ≥ 24 حرفاً، احتفظ بنسخة منه.
# PASS_PEPPER=
# دخول المالك من الخادم (بدل كتابته في admin.html)
# OWNER_USER=
# OWNER_HASH=
# حارس حفظ القيمة: enforce | log | off
# BAL_GUARD=enforce
